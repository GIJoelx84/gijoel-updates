      <type>horizontal</type><pos>0.05 0.27</pos><size>0.90 0.42</size><origin>0 0</origin>
      <color>00000000</color><logoScale>1</logoScale><logoSize>0.50 0.23</logoSize><maxLogoCount>1</maxLogoCount>
    </carousel>
    <image name="logo"><path>./_inc/logos/${system.theme}.svg</path></image>
    <text name="systemInfo"><pos>0.10 0.73</pos><size>0.80 0.06</size><alignment>center</alignment>
      <fontPath>./_inc/fonts/WorkSans-Bold.ttf</fontPath><fontSize>0.035</fontSize><color>FFFFFF</color></text>
  </view>
  <view name="basic,detailed,video">
    <text name="logoText"><pos>0.055 0.055</pos><size>0.5 0.08</size><alignment>left</alignment><fontPath>./_inc/fonts/WorkSans-Bold.ttf</fontPath><fontSize>0.045</fontSize><color>FFFFFF</color></text>
    <image name="logo"><path>./_inc/logos/${system.theme}.svg</path><origin>0 0</origin><pos>0.055 0.055</pos><maxSize>0.25 0.08</maxSize></image>
    <textlist name="gamelist">
      <pos>0.27 0.30</pos><size>0.38 0.64</size><alignment>left</alignment>
      <fontPath>./_inc/fonts/WorkSans-Bold.ttf</fontPath><fontSize>0.038</fontSize><lineSpacing>1.5</lineSpacing>
