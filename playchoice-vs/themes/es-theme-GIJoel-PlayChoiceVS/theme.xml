      <path>./_inc/background.svg</path><pos>0 0</pos><size>1 1</size><zIndex>0</zIndex>
    </image>
    <image name="gijoel-logo" extra="true">
      <path>./_inc/images/gijoel-logo.png</path><pos>0.055 0.17</pos><maxSize>0.42 0.04875</maxSize><zIndex>10</zIndex>
    </image>
    <image name="gijoel-character" extra="true"><path>./_inc/images/background.png</path><origin>0 1</origin><pos>0 1</pos><maxSize>0.56 1</maxSize><zIndex>1</zIndex></image>
    <image name="overlay-custom" extra="true"><path>./_inc/images/overlay.png</path><origin>0 0</origin><pos>0 0</pos><size>1 1</size><tile>false</tile><zIndex>999</zIndex></image>
    <helpsystem name="help"><pos>1 1</pos></helpsystem>
  </view>
  <view name="system">
