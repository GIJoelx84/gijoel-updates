    <datetime name="md_lastplayed,md_releasedate"><pos>1 1</pos></datetime>
    <rating name="md_rating"><pos>1 1</pos></rating>
  </view>
  <view name="video"><video name="md_video"><pos>1 1</pos></video><image name="md_marquee"><pos>1 1</pos></image></view>
</theme>
